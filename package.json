{
  "name": "soliguard",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free, heuristic Solidity static-analysis security linter. Pre-audit screening only — NOT a substitute for a professional audit.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "soliguard": "soliguard.js"
  },
  "files": [
    "soliguard.js",
    "README.md",
    "RULES.md",
    "TECHNICAL_SUMMARY.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples/"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "node soliguard.js examples/VulnerableToken.sol",
    "lint:json": "node soliguard.js examples/VulnerableToken.sol --json"
  },
  "keywords": [
    "solidity",
    "security",
    "linter",
    "static-analysis",
    "smart-contracts",
    "ethereum",
    "web3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cybrsecuritesolutions/soliguard.git"
  }
}